{
  "name": "site-walker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Site Walker — paste a URL, get one full-page screenshot per section. Fastify + Playwright, single Railway container.",
  "scripts": {
    "agent:run": "tsx tools/run-agent.ts",
    "extract-design": "tsx tools/extract-design.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "vitest run",
    "dev:server": "tsx server/index.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.0",
    "@fastify/static": "^8.1.0",
    "archiver": "^7.0.1",
    "fastify": "^5.4.0",
    "playwright": "1.64.1",
    "sharp": "^0.34.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
